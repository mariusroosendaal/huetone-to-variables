{
  "name": "huetone-colors-to-variables",
  "version": "1.0.0",
  "description": "Import Huetone JSON color palettes as Figma color variables",
  "type": "module",
  "author": "Marius Roosendaal",
  "license": "MIT",
  "keywords": [
    "figma",
    "figma-plugin",
    "svelte",
    "huetone",
    "color",
    "variables"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "vite build && vite build --mode code",
    "dev": "vite build --watch & vite build --watch --mode code",
    "lint": "tsc --noEmit && eslint . --ext .ts,.js,.svelte && npx prettier --check \"src/**/*.{js,ts,svelte,html,css}\"",
    "prettier": "npx prettier --write \"src/**/*.{js,ts,svelte,html,css}\""
  },
  "dependencies": {
    "figma-plugin-utilities": "file:../_packages/figma-plugin-utilities"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@figma/plugin-typings": "^1.138.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.2",
    "@types/node": "^22.13.4",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.23.0",
    "figma-ui3-kit-svelte": "file:..//_packages/figma-ui3-kit-svelte",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^4.2.20",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.2.0"
  }
}
